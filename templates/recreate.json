{
  "name": "Recreate a piece",
  "description": "A clear click and an empty piano clip for finding a tune by ear: it should feel plain, patient and ready.",
  "tempo": 90,
  "key": "C major",
  "ticks_per_quarter": 960,
  "loop": {"start": 0, "end": 15360},
  "commands": [
    {"command": "set_project_name", "name": "Recreate by ear"},
    {"command": "set_tempo", "tick": 0, "mbpm": 90000},
    {"command": "add_track", "id": "$t1", "name": "Click", "kind": "instrument", "index": null},
    {"command": "set_instrument", "track": "$t1", "instrument": "00000000000000000000000000000002"},
    {"command": "set_track_sound", "track": "$t1", "sound": "builtin-pluck"},
    {"command": "set_track_volume", "track": "$t1", "volume": 350},
    {"command": "add_region", "id": "$r1", "track": "$t1", "start": 0, "length": 15360, "kind": "midi"},
    {"command": "add_note", "id": "$n1", "region": "$r1", "pitch": 96, "velocity": 110, "start": 0, "duration": 120},
    {"command": "add_note", "id": "$n2", "region": "$r1", "pitch": 88, "velocity": 70, "start": 960, "duration": 120},
    {"command": "add_note", "id": "$n3", "region": "$r1", "pitch": 88, "velocity": 70, "start": 1920, "duration": 120},
    {"command": "add_note", "id": "$n4", "region": "$r1", "pitch": 88, "velocity": 70, "start": 2880, "duration": 120},
    {"command": "add_note", "id": "$n5", "region": "$r1", "pitch": 96, "velocity": 110, "start": 3840, "duration": 120},
    {"command": "add_note", "id": "$n6", "region": "$r1", "pitch": 88, "velocity": 70, "start": 4800, "duration": 120},
    {"command": "add_note", "id": "$n7", "region": "$r1", "pitch": 88, "velocity": 70, "start": 5760, "duration": 120},
    {"command": "add_note", "id": "$n8", "region": "$r1", "pitch": 88, "velocity": 70, "start": 6720, "duration": 120},
    {"command": "add_note", "id": "$n9", "region": "$r1", "pitch": 96, "velocity": 110, "start": 7680, "duration": 120},
    {"command": "add_note", "id": "$n10", "region": "$r1", "pitch": 88, "velocity": 70, "start": 8640, "duration": 120},
    {"command": "add_note", "id": "$n11", "region": "$r1", "pitch": 88, "velocity": 70, "start": 9600, "duration": 120},
    {"command": "add_note", "id": "$n12", "region": "$r1", "pitch": 88, "velocity": 70, "start": 10560, "duration": 120},
    {"command": "add_note", "id": "$n13", "region": "$r1", "pitch": 96, "velocity": 110, "start": 11520, "duration": 120},
    {"command": "add_note", "id": "$n14", "region": "$r1", "pitch": 88, "velocity": 70, "start": 12480, "duration": 120},
    {"command": "add_note", "id": "$n15", "region": "$r1", "pitch": 88, "velocity": 70, "start": 13440, "duration": 120},
    {"command": "add_note", "id": "$n16", "region": "$r1", "pitch": 88, "velocity": 70, "start": 14400, "duration": 120},
    {"command": "add_track", "id": "$t2", "name": "Piano", "kind": "instrument", "index": null},
    {"command": "set_instrument", "track": "$t2", "instrument": "00000000000000000000000000000001"},
    {"command": "set_track_sound", "track": "$t2", "sound": "builtin-soft-piano"},
    {"command": "add_region", "id": "$r2", "track": "$t2", "start": 0, "length": 15360, "kind": "midi"}
  ]
}
