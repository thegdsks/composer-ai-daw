# Scale budget knobs for `cargo run --release -p composer-bench`.
# Export the variables you want enforced. A budget that is unset is reported
# but not enforced. Suggested CI values live in bench/baseline.yaml (with
# headroom); nothing here is a built in default.
#
# Workload size (defaults are in code, they size the project, they do not gate):
#   COMPOSER_BENCH_TRACKS=300 COMPOSER_BENCH_REGIONS_PER_TRACK=10
#   COMPOSER_BENCH_NOTES_PER_REGION=50 COMPOSER_BENCH_UNDO_DEPTH=10000
#   COMPOSER_BENCH_SEED=1 COMPOSER_BENCH_RENDER_TRACKS=32
#   COMPOSER_BENCH_RENDER_SECONDS=300 COMPOSER_BENCH_RENDER_RATE=48000
#   COMPOSER_BENCH_SWEEP_REGIONS=1000,4000,16000,64000
#   COMPOSER_BENCH_SWEEP_TRACKS=64,256,1024,4000 COMPOSER_BENCH_LOOKUPS=200000
#
# Budgets (upper bounds):
#   COMPOSER_BENCH_MAX_APPLY_NS         ns per executed command
#   COMPOSER_BENCH_MAX_UNDO_NS          ns per undo step
#   COMPOSER_BENCH_MAX_REDO_NS          ns per redo step
#   COMPOSER_BENCH_MAX_STATE_HASH_MS    ms for one state_hash of the full project
#   COMPOSER_BENCH_MAX_SAVE_MS          ms for write_project
#   COMPOSER_BENCH_MAX_LOAD_MS          ms for read_project
#   COMPOSER_BENCH_MAX_RENDER_RTF       render time / audio time
#   COMPOSER_BENCH_MAX_LOOKUP_RATIO     lookup ns at largest size / smallest size
#   COMPOSER_BENCH_MAX_APPLY_RATIO      apply ns at largest size / smallest size
#   COMPOSER_BENCH_MAX_EDIT_MS          edit_latency bin: ms of add_note, undo or redo at the largest size (D47)
#   COMPOSER_BENCH_MAX_EDIT_RATIO       edit_latency bin: add_note median at the largest size / smallest
#   Workload of edit_latency: COMPOSER_BENCH_EDIT_SIZES=1000,20000,150000 COMPOSER_BENCH_EDIT_OPS=200
